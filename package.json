{
  "name": "@davo20019/seo-audit",
  "version": "0.5.0",
  "type": "module",
  "description": "Crawl-based SEO audit CLI with JS rendering, JSON-LD validation, CrUX field data, sitemap walking, HTML/PDF reports, and crawl diffing.",
  "license": "MIT",
  "author": "David Loor",
  "homepage": "https://github.com/davo20019/seo-analysis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davo20019/seo-analysis.git"
  },
  "bugs": {
    "url": "https://github.com/davo20019/seo-analysis/issues"
  },
  "keywords": [
    "seo",
    "audit",
    "crawler",
    "lighthouse",
    "schema",
    "json-ld",
    "core-web-vitals",
    "crux",
    "sitemap",
    "playwright",
    "headless",
    "cli",
    "open-source"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "seo-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/prepare-cli.cjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "lighthouse": "^12.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
